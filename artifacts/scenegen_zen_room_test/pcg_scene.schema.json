{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pcg_scene.schema.json",
  "title": "Next Anima PCG Scene",
  "type": "object",
  "required": [
    "schemaVersion",
    "sceneId",
    "coordinateSystem",
    "metricCalibration",
    "room",
    "objects",
    "initialConditions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sceneId": { "type": "string", "minLength": 1 },
    "coordinateSystem": {
      "type": "object",
      "required": ["target", "upAxis", "units", "sourceToTarget"]
    },
    "metricCalibration": {
      "type": "object",
      "required": ["metersPerSceneGenUnit", "method", "confidence"]
    },
    "room": {
      "type": "object",
      "required": ["dimensionsCm", "surfaces", "openings", "inference"]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "category",
          "asset",
          "transform",
          "dimensionsCm",
          "anchor",
          "collision",
          "sourceSegmentation",
          "pcg"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "asset": {
            "type": "object",
            "required": ["uri", "format", "units", "textures"]
          },
          "transform": {
            "type": "object",
            "required": ["locationCm", "rotationEulerDeg", "scale"]
          },
          "dimensionsCm": {
            "type": "array",
            "prefixItems": [
              { "type": "number" },
              { "type": "number" },
              { "type": "number" }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      }
    },
    "initialConditions": {
      "type": "object",
      "required": ["deterministicSeed", "groundSurfaceId", "placementRules", "pcgInputs"]
    }
  }
}
